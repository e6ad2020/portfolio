---
// src/components/hero/Hero.astro
---

<section class="hero" id="hero" aria-label="Hero Section">
  <!-- Layer 0: Ambient Cinematic Radial Glows -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__glow hero__glow--warm"></div>
    <div class="hero__glow hero__glow--cool"></div>
  </div>

  <!-- Layer 1: Giant Background Title (Behind Subject) -->
  <div class="hero__title-container" aria-hidden="true">
    <h1 class="hero__title font-display">PORTFOLIO</h1>
  </div>

  <!-- Layer 2 Fallback: Instant LCP Image (fades out when WebGL loads) -->
  <div class="hero__fallback-container" id="hero-fallback-wrapper">
    <img
      src="/textures/hero/portrait-fallback.webp"
      alt="Eyad Gaber - Full Stack Engineer & Systems Developer"
      id="hero-fallback-img"
      class="hero__fallback-img"
      width="1536"
      height="1024"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- Layer 3: Four Corner Meta Labels & Directives -->
  <div class="hero__labels">
    <!-- Top Left -->
    <div class="hero__label hero__label--top-left">
      <span class="label__badge">EYAD GABER</span>
      <span class="label__desc">FULL STACK ENGINEER &amp; SYSTEMS DEVELOPER</span>
    </div>

    <!-- Top Right -->
    <div class="hero__label hero__label--top-right">
      <span class="status-indicator">
        <span class="status-dot"></span>
        <span class="status-pulse"></span>
      </span>
      <span class="label__desc">AVAILABLE FOR WORK</span>
    </div>

    <!-- Bottom Left -->
    <div class="hero__label hero__label--bottom-left">
      <span class="label__meta">CORE DOMAINS</span>
      <span class="label__val">LINUX, NETWORKS &amp; WEB APPS</span>
    </div>

    <!-- Bottom Right -->
    <div class="hero__label hero__label--bottom-right">
      <a href="#work" class="hero__scroll-indicator" aria-label="Scroll to projects">
        <span class="scroll-text">EXPLORE WORK</span>
        <svg class="scroll-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19 12 12 19 5 12"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background-color: var(--bg-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Layer 0: Glows */
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: var(--z-glow);
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    width: clamp(350px, 45vw, 750px);
    height: clamp(350px, 45vw, 750px);
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.45;
    mix-blend-mode: screen;
    will-change: transform, opacity;
  }

  .hero__glow--warm {
    top: 15%;
    left: -10%;
    background: radial-gradient(circle, rgba(255, 85, 0, 0.75) 0%, rgba(255, 120, 0, 0.25) 50%, transparent 70%);
    animation: driftWarm 14s ease-in-out infinite alternate;
  }

  .hero__glow--cool {
    bottom: 10%;
    right: -10%;
    background: radial-gradient(circle, rgba(0, 210, 255, 0.65) 0%, rgba(0, 140, 255, 0.2) 50%, transparent 70%);
    animation: driftCool 16s ease-in-out infinite alternate;
  }

  @keyframes driftWarm {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(6vw, 4vh) scale(1.1); }
    100% { transform: translate(-3vw, -5vh) scale(0.95); }
  }

  @keyframes driftCool {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-5vw, -4vh) scale(1.12); }
    100% { transform: translate(4vw, 3vh) scale(0.92); }
  }

  /* Layer 1: Giant Title */
  .hero__title-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -52%);
    width: 100%;
    text-align: center;
    z-index: var(--z-title);
    pointer-events: none;
    user-select: none;
  }

  .hero__title {
    font-size: clamp(4.5rem, 19vw, 19.5rem);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.12);
    text-shadow: 0 0 80px rgba(255, 255, 255, 0.03);
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }

  /* Layer 2: LCP Static Fallback */
  .hero__fallback-container {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    pointer-events: none;
    z-index: var(--z-fallback);
    opacity: 1;
    transition: opacity 0.75s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: opacity;
  }

  .hero__fallback-container.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .hero__fallback-container.is-removed {
    display: none !important;
    visibility: hidden !important;
  }

  .hero__fallback-img {
    height: 109vh;
    width: auto;
    max-width: 95vw;
    object-fit: contain;
    object-position: bottom center;
    transition: opacity 0.75s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Layer 3: Four Corner Labels */
  .hero__labels {
    position: absolute;
    inset: 0;
    padding: clamp(1.5rem, 3.5vw, 3.5rem);
    pointer-events: none;
    z-index: var(--z-content);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero__label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    pointer-events: auto;
  }

  .hero__label--top-left {
    position: absolute;
    top: clamp(1.5rem, 3.5vw, 3rem);
    left: clamp(1.5rem, 3.5vw, 3.5rem);
  }

  .label__badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #ffffff;
  }

  .label__desc {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
  }

  .hero__label--top-right {
    position: absolute;
    top: clamp(1.5rem, 3.5vw, 3rem);
    right: clamp(1.5rem, 3.5vw, 3.5rem);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.65rem;
  }

  .status-indicator {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 8px;
    height: 8px;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00ffaa;
  }

  .status-pulse {
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: rgba(0, 255, 170, 0.4);
    animation: statusPulse 2s cubic-bezier(0.24, 0, 0.38, 1) infinite;
  }

  @keyframes statusPulse {
    0% { transform: scale(0.6); opacity: 0.8; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  .hero__label--bottom-left {
    position: absolute;
    bottom: clamp(1.5rem, 3.5vw, 3.5rem);
    left: clamp(1.5rem, 3.5vw, 3.5rem);
  }

  .label__meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: var(--text-muted);
  }

  .label__val {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
  }

  .hero__label--bottom-right {
    position: absolute;
    bottom: clamp(1.5rem, 3.5vw, 3.5rem);
    right: clamp(1.5rem, 3.5vw, 3.5rem);
  }

  .hero__scroll-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--text-secondary);
    padding: 0.6rem 1.1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    backdrop-filter: blur(12px);
    transition: all 0.3s ease;
  }

  .hero__scroll-indicator:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(2px);
  }

  .scroll-arrow {
    animation: bounceDown 1.8s ease-in-out infinite;
  }

  @keyframes bounceDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  /* Responsive Rules for Small Devices (Phones & Tablets in Portrait) */
  @media (max-width: 768px), (orientation: portrait) {
    .hero__glow {
      width: 85vw;
      height: 85vw;
      filter: blur(80px);
      opacity: 0.55;
    }

    .hero__glow--warm {
      top: 10%;
      left: -25%;
    }

    .hero__glow--cool {
      top: 16%;
      right: -25%;
    }

    .hero__title-container {
      position: absolute;
      top: 34%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100vw;
      padding: 0 1rem;
    }

    .hero__title {
      font-size: clamp(2.8rem, 15vw, 4.8rem);
      letter-spacing: -0.04em;
      color: rgba(255, 255, 255, 0.22);
      text-shadow: 0 0 50px rgba(255, 255, 255, 0.08);
      white-space: nowrap;
    }

    .hero__label--top-left {
      top: max(1.15rem, env(safe-area-inset-top, 1.15rem));
      left: max(1.15rem, env(safe-area-inset-left, 1.15rem));
    }

    .hero__label--top-right {
      top: max(1.15rem, env(safe-area-inset-top, 1.15rem));
      right: max(1.15rem, env(safe-area-inset-right, 1.15rem));
    }

    .hero__label--top-right .label__desc {
      display: none;
    }

    .hero__labels {
      padding: 1.15rem;
    }

    /* Hide left bottom label on phone to eliminate overlapping collision */
    .hero__label--bottom-left {
      display: none;
    }

    /* Center the explore button at the bottom for thumb ergonomics */
    .hero__label--bottom-right {
      position: absolute;
      bottom: max(1.4rem, env(safe-area-inset-bottom, 1.4rem));
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      width: max-content;
    }

    .hero__scroll-indicator {
      padding: 0.6rem 1.25rem;
      font-size: 0.72rem;
      background: rgba(14, 14, 19, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55);
    }

    .hero__fallback-img {
      height: 71vh;
      height: 71svh;
      max-height: 71vh;
      max-height: 71svh;
      max-width: none;
      width: auto;
    }
  }
</style>
