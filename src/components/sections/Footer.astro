---
// src/components/sections/Footer.astro
---

<footer class="footer" role="contentinfo">
  <div class="container footer-container">
    <div class="footer-left">
      <span class="footer-copy">&copy; {new Date().getFullYear()} EYAD GABER &bull; LICENSED UNDER GNU GPLv3</span>
      <span class="footer-stack">ENGINEERED WITH ASTRO &bull; REACT &bull; THREE.JS &bull; TYPESCRIPT</span>
    </div>

    <div class="footer-center">
      <div class="time-widget">
        <span class="time-dot"></span>
        <span class="time-label">CAIRO:</span>
        <span class="time-display" id="cairo-clock">--:--:-- UTC+3</span>
      </div>
    </div>

    <div class="footer-right">
      <button id="back-to-top" class="back-top-btn" aria-label="Scroll back to top of page">
        <span>TOP</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="19" x2="12" y2="5"></line>
          <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
      </button>
    </div>
  </div>
</footer>

<script>
  // Live Cairo Time Clock
  function updateCairoTime() {
    const clock = document.getElementById('cairo-clock');
    if (!clock) return;
    const now = new Date();
    const options: Intl.DateTimeFormatOptions = {
      timeZone: 'Africa/Cairo',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    };
    clock.textContent = `${new Intl.DateTimeFormat([], options).format(now)} UTC+3`;
  }

  updateCairoTime();
  setInterval(updateCairoTime, 1000);

  import { getLenis } from '../../lib/motion';

  // Back to Top smooth scroll
  const topBtn = document.getElementById('back-to-top');
  if (topBtn) {
    topBtn.addEventListener('click', () => {
      const lenis = getLenis();
      if (lenis) {
        lenis.scrollTo(0, { duration: 1.2 });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }
</script>

<style>
  .footer {
    position: relative;
    padding: 2.5rem 0;
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-primary);
    z-index: var(--z-content);
  }

  .footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
  }

  .footer-stack {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .footer-center {
    display: flex;
    align-items: center;
  }

  .time-widget {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .time-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-secondary);
  }

  .time-label {
    color: var(--text-muted);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .time-display {
    color: #ffffff;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .footer-right {
    display: flex;
    align-items: center;
  }

  .back-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    transition: all 0.25s ease;
  }

  .back-top-btn:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .footer-left {
      align-items: center;
    }
  }
</style>
