---
// src/components/sections/Philosophy.astro

interface BeliefPillar {
  number: string;
  title: string;
  summary: string;
  tag: string;
}

const pillars: BeliefPillar[] = [
  {
    number: '01',
    title: 'Clean & Community-Driven',
    summary: 'Software engineered out in the open by people, for people. Free from vendor lock-in, commercial dark patterns, and artificial moats. Built with genuine collaboration and transparent craftsmanship.',
    tag: 'FOSS SPIRIT'
  },
  {
    number: '02',
    title: 'Zero Invasive Telemetry',
    summary: 'Absolute respect for user privacy and machine sovereignty. No sneaky background telemetry, no behavioral profiling, and no harvested metrics disguised as diagnostics. Your machine belongs to you.',
    tag: 'PRIVACY FIRST'
  },
  {
    number: '03',
    title: 'The Future of Major Software',
    summary: 'OSS is the inevitable future not just for libraries, frameworks, and developer tooling, but for major full-scale consumer and enterprise applications where users demand trust, security, and true ownership.',
    tag: 'APPLICATION HORIZON'
  },
  {
    number: '04',
    title: 'Joyful & Ergonomic Experiences',
    summary: 'Open source should never mean clunky interfaces or compromised UX. I strive to build utilities and applications that feel blazing fast, deeply refined, accessible, and a genuine joy to use every day.',
    tag: 'CRAFT & DELIGHT'
  }
];
---

<section class="philosophy-section" id="philosophy" aria-label="My Philosophy - Open Source">
  <div class="container">
    <div class="section-header">
      <div class="section-badge">
        <span class="badge-line"></span>
        <span class="badge-text tracking-wide-caps">MY PHILOSOPHY // WHAT I LOVE</span>
      </div>

      <div class="philosophy-title-wrap">
        <h2 class="section-title font-display">
          EYAD <span class="heart-pulse" aria-label="loves">&#10084;</span> OSS
        </h2>
      </div>
    </div>

    <!-- Core Lead Manifesto Card -->
    <div class="manifesto-lead glass-panel">
      <div class="manifesto-glow" aria-hidden="true"></div>
      <p class="manifesto-quote">
        "I love clean, community-driven open-source software that deeply respects users’ privacy, completely eliminates intrusive telemetry, and delivers an experience that people genuinely enjoy."
      </p>
      <p class="manifesto-vision">
        I believe open-source software is the inevitable future of all computing—not merely in libraries, frameworks, and developer tools, but as the cornerstone of major everyday software applications.
      </p>
      <div class="manifesto-author font-mono">
        <span class="author-prefix">//</span> EYAD GABER &bull; CORE BELIEF &amp; VISION
      </div>
    </div>

    <!-- Pillars Grid -->
    <div class="pillars-grid">
      {pillars.map(pillar => (
        <div class="pillar-card glass-panel">
          <div class="pillar-top">
            <span class="pillar-num font-mono">{pillar.number}</span>
            <span class="pillar-tag font-mono">{pillar.tag}</span>
          </div>
          <h3 class="pillar-title">{pillar.title}</h3>
          <p class="pillar-desc">{pillar.summary}</p>
        </div>
      ))}
    </div>

    <!-- Terminal Status Banner -->
    <div class="terminal-banner font-mono">
      <div class="terminal-dots">
        <span class="dot dot--red"></span>
        <span class="dot dot--yellow"></span>
        <span class="dot dot--green"></span>
      </div>
      <div class="terminal-code">
        <span class="terminal-prompt">$</span>
        <span class="terminal-cmd">cat /etc/eyad-ethos.conf</span>
        <span class="terminal-output">&rarr; PRIVACY=TRUE &bull; TELEMETRY=DISABLED &bull; OSS_FUTURE=ALL_APPLICATIONS</span>
      </div>
    </div>
  </div>
</section>

<style>
  .philosophy-section {
    position: relative;
    padding: clamp(6rem, 10vw, 10rem) 0;
    background-color: var(--bg-primary);
    z-index: var(--z-content);
    overflow: hidden;
  }

  .section-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: var(--space-sm);
  }

  .badge-line {
    width: 28px;
    height: 1px;
    background: var(--accent-secondary);
  }

  .badge-text {
    color: var(--accent-secondary);
    font-size: var(--text-xs);
  }

  .philosophy-title-wrap {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .section-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .heart-pulse {
    display: inline-block;
    color: #ff3366;
    text-shadow: 0 0 25px rgba(255, 51, 102, 0.7);
    animation: heartbeat 2s ease-in-out infinite;
    transform-origin: center;
    font-size: 0.95em;
  }

  @keyframes heartbeat {
    0%, 100% {
      transform: scale(1);
    }
    14% {
      transform: scale(1.22);
    }
    28% {
      transform: scale(1);
    }
    42% {
      transform: scale(1.15);
    }
    70% {
      transform: scale(1);
    }
  }

  /* Lead Manifesto Box */
  .manifesto-lead {
    position: relative;
    padding: clamp(2.5rem, 4vw, 3.5rem);
    background: radial-gradient(circle at top left, rgba(255, 51, 102, 0.08) 0%, rgba(14, 14, 19, 0.75) 60%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
    overflow: hidden;
  }

  .manifesto-glow {
    position: absolute;
    top: -50px;
    right: -50px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(0, 210, 255, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    filter: blur(50px);
    pointer-events: none;
  }

  .manifesto-quote {
    font-size: clamp(1.25rem, 2.2vw, 1.85rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 1rem;
    max-width: 980px;
  }

  .manifesto-vision {
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    max-width: 920px;
  }

  .manifesto-author {
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    font-weight: 600;
  }

  .author-prefix {
    color: var(--text-muted);
  }

  /* Pillars Grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.25rem, 2vw, 2rem);
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .pillar-card {
    padding: clamp(2rem, 3vw, 2.5rem);
    background: rgba(14, 14, 19, 0.55);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .pillar-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: 0 16px 32px -10px rgba(0, 0, 0, 0.6);
  }

  .pillar-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pillar-num {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent-secondary);
    letter-spacing: 0.1em;
  }

  .pillar-tag {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    padding: 0.2rem 0.55rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
  }

  .pillar-title {
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .pillar-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Terminal Status Banner */
  .terminal-banner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem 1.5rem;
    background: rgba(7, 7, 9, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    overflow-x: auto;
  }

  .terminal-dots {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .dot--red { background: #ff5f56; }
  .dot--yellow { background: #ffbd2e; }
  .dot--green { background: #27c93f; }

  .terminal-code {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    white-space: nowrap;
  }

  .terminal-prompt {
    color: var(--accent-primary);
    font-weight: 700;
  }

  .terminal-cmd {
    color: #ffffff;
    font-weight: 500;
  }

  .terminal-output {
    color: var(--accent-secondary);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  @media (max-width: 800px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }

    .terminal-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
