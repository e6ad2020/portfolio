---
// src/components/sections/Experience.astro

interface ExperienceItem {
  domain: string;
  focus: string;
  role: string;
  badge: string;
  description: string;
  highlights: string[];
}

const experiences: ExperienceItem[] = [
  {
    domain: '01 // LINUX SYSTEMS',
    focus: 'OS & DESKTOP INTERNALS',
    role: 'Linux Systems & Desktop Developer',
    badge: 'GJS • BASH • SYSTEMD',
    description: 'Deep passion for Linux internals, custom desktop environments, and shell architecture. Designing seamless system-level workflows, shell extensions, and native OS integrations.',
    highlights: [
      'Authored native GNOME Shell extensions utilizing GJS, GObject Introspection, and Shell CSS',
      'Engineered automated Bash scripting pipelines, systemd services, and custom OS hooks',
      'Extensive experience with Linux kernel tuning, multi-distro management, and terminal workflow optimization'
    ]
  },
  {
    domain: '02 // OPEN SOURCE',
    focus: 'FOSS ADVOCACY & COMMUNITY',
    role: 'Open-Source (OSS) Developer',
    badge: 'FOSS • PUBLIC REPOS • TOOLS',
    description: 'Committed to the open-source philosophy of software transparency, accessibility, and community collaboration. Actively designing and maintaining publicly available software.',
    highlights: [
      'Maintained 15+ open-source repositories spanning desktop utilities, system tools, and web apps',
      'Engineered community-driven software with clean documentation, modular codebases, and open licenses',
      'Passionate advocate for software freedom, vendor-neutral tools, and collaborative open ecosystems'
    ]
  },
  {
    domain: '03 // SYSADMIN',
    focus: 'SERVER OPS & HOSTING',
    role: 'Linux Server Administrator',
    badge: 'SERVICES • PROXIES • SECURITY',
    description: 'Extensive hands-on experience in provisioning, configuring, and hardening Linux servers, deploying full-stack web services, and ensuring continuous reliability and security.',
    highlights: [
      'Configured and hardened headless Linux servers with SSH keys, UFW/iptables, and strict user permissions',
      'Deployed real-time applications and databases using reverse proxies, automated SSL certificates, and process daemons',
      'Implemented active telemetry monitoring, automated backup routines, and resource load optimization'
    ]
  },
  {
    domain: '04 // IT & NETWORKS',
    focus: 'INFRASTRUCTURE & HARDWARE',
    role: 'IT Systems & Network Specialist',
    badge: 'TCP/IP • DNS • HARDWARE',
    description: 'Solid foundation in computer networking, hardware architectures, and IT infrastructure diagnostics. Diagnosing and resolving complex challenges across hardware and network layers.',
    highlights: [
      'Configured local area network topographies, DHCP routing, DNS resolution, and network segmentation',
      'Diagnosed and resolved critical hardware bottlenecks, OS failures, and network latency anomalies',
      'Applied deep knowledge of network protocols (TCP/IP, UDP, WebSockets) for high-reliability data exchange'
    ]
  }
];
---

<section class="experience-section" id="experience" aria-label="Experience & Expertise">
  <div class="container">
    <div class="section-header">
      <div class="section-badge">
        <span class="badge-line"></span>
        <span class="badge-text tracking-wide-caps">CORE PILLARS</span>
      </div>
      <h2 class="section-title">EXPERIENCE &amp; FOCUS</h2>
    </div>

    <div class="timeline">
      {experiences.map(item => (
        <div class="timeline-item">
          <div class="timeline-meta">
            <span class="timeline-period">{item.domain}</span>
            <span class="timeline-location">{item.focus}</span>
          </div>

          <div class="timeline-content glass-panel">
            <div class="timeline-role-wrap">
              <h3 class="timeline-role">{item.role}</h3>
              <span class="timeline-company">{item.badge}</span>
            </div>

            <p class="timeline-desc">{item.description}</p>

            <ul class="timeline-highlights">
              {item.highlights.map(h => (
                <li class="highlight-item">
                  <span class="highlight-bullet">▹</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section {
    position: relative;
    padding: clamp(6rem, 10vw, 10rem) 0;
    background-color: var(--bg-primary);
    z-index: var(--z-content);
  }

  .section-header {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: var(--space-sm);
  }

  .badge-line {
    width: 28px;
    height: 1px;
    background: var(--accent-primary);
  }

  .badge-text {
    color: var(--accent-primary);
    font-size: var(--text-xs);
  }

  .section-title {
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2.5rem;
    align-items: flex-start;
  }

  .timeline-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1rem;
  }

  .timeline-period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
  }

  .timeline-location {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .timeline-content {
    padding: clamp(2rem, 3vw, 2.75rem);
    background: rgba(14, 14, 19, 0.5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: border-color 0.3s ease;
  }

  .timeline-content:hover {
    border-color: rgba(255, 255, 255, 0.18);
  }

  .timeline-role-wrap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .timeline-role {
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .timeline-company {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-secondary);
    letter-spacing: 0.1em;
  }

  .timeline-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .timeline-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .highlight-bullet {
    color: var(--accent-secondary);
    font-size: 0.8rem;
  }

  @media (max-width: 800px) {
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .timeline-meta {
      flex-direction: row;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding-top: 0;
    }
  }
</style>
